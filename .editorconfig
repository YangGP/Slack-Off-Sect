# 统一编辑器约定（避免 BOM / CRLF / 缺行尾换行这类问题）
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

[*.{js,mjs,vue,css}]
indent_style = space
indent_size = 2
