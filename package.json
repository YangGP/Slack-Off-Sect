{
  "name": "slack-off-sect",
  "private": true,
  "version": "0.3.0",
  "license": "MIT",
  "description": "Slack Off Sect (摸鱼宗门) —— 一个 Vue3 + Vite 的修仙宗门挂机放置游戏",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "smoke": "vite build --ssr tools/smoke.mjs --outDir .smoke --emptyOutDir && node .smoke/smoke.js",
    "check:render": "vite build --ssr tools/render-check.mjs --outDir .smoke-render --emptyOutDir && node .smoke-render/render-check.js",
    "check:dom": "vite build --config tools/vite.domcheck.config.js && node tools/dom-check.mjs",
    "check": "npm run check:encoding && npm run check:tools && npm run smoke && npm run check:render && npm run check:dom",
    "check:tools": "vite build --ssr tools/audit-check.mjs --outDir .smoke-tools --emptyOutDir && node .smoke-tools/audit-check.js",
    "clean": "node tools/clean.mjs",
    "check:encoding": "node tools/check-encoding.mjs",
    "audit": "vite build --ssr tools/resource-audit.mjs --outDir .smoke-audit --emptyOutDir && node .smoke-audit/resource-audit.js",
    "balance": "vite build --ssr tools/balance.mjs --outDir .smoke-balance --emptyOutDir && node .smoke-balance/balance.js",
    "audit:economy": "vite build --ssr tools/economy-audit.mjs --outDir .smoke-economy --emptyOutDir && node .smoke-economy/economy-audit.js",
    "audit:crafts": "vite build --ssr tools/tier-audit.mjs --outDir .smoke-tier --emptyOutDir && node .smoke-tier/tier-audit.js",
    "audit:buildings": "vite build --ssr tools/building-reachability.mjs --outDir .smoke-reachability --emptyOutDir && node .smoke-reachability/building-reachability.js",
    "audit:pacing": "vite build --ssr tools/pacing-audit.mjs --outDir .smoke-pacing --emptyOutDir && node .smoke-pacing/pacing-audit.js",
    "audit:breakthrough": "vite build --ssr tools/breakthrough-time-audit.mjs --outDir .smoke-breakthrough-time --emptyOutDir && node .smoke-breakthrough-time/breakthrough-time-audit.js",
    "audit:breakthrough-risk": "vite build --ssr tools/breakthrough-risk-model.mjs --outDir .smoke-breakthrough-risk --emptyOutDir && node .smoke-breakthrough-risk/breakthrough-risk-model.js",
    "balance:events": "vite build --ssr tools/event-balance.mjs --outDir .smoke-event-balance --emptyOutDir && node .smoke-event-balance/event-balance.js",
    "balance:visits": "vite build --ssr tools/playstyles.mjs --outDir .smoke-visits --emptyOutDir && node .smoke-visits/playstyles.js",
    "docs:tables": "node tools/dump-tables.mjs"
  },
  "dependencies": {
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "jsdom": "^30.1.2",
    "vite": "^8.3.3"
  }
}
