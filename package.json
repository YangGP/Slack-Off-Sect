{
  "name": "slack-off-sect",
  "private": true,
  "version": "0.422",
  "license": "MIT",
  "description": "Slack Off Sect (摸鱼宗门) —— 一个 Vue3 + Vite 的修仙宗门挂机放置游戏",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "smoke": "node tools/run.mjs smoke",
    "check:render": "node tools/run.mjs render-check",
    "check:dom": "vite build --config tools/vite.domcheck.config.js && node tools/dom-check.mjs",
    "check:industry": "node tools/run.mjs industry-scenarios",
    "check": "npm run check:encoding && npm run check:tools && npm run smoke && npm run check:render && npm run check:startup && npm run check:dom",
    "check:startup": "node tools/startup-check.mjs",
    "check:tools": "node tools/run.mjs audit-check",
    "clean": "node tools/clean.mjs",
    "check:encoding": "node tools/check-encoding.mjs",
    "audit": "node tools/run.mjs resource-audit",
    "audit:disciples": "node tools/run.mjs disciple-audit",
    "balance": "node tools/run.mjs balance",
    "audit:economy": "node tools/run.mjs economy-audit",
    "audit:crafts": "node tools/run.mjs tier-audit",
    "audit:buildings": "node tools/run.mjs building-reachability",
    "audit:power": "node tools/run.mjs power-audit",
    "audit:sources": "node tools/run.mjs upgrade-source-audit",
    "audit:pacing": "node tools/run.mjs pacing-audit",
    "audit:breakthrough": "node tools/run.mjs breakthrough-time-audit",
    "audit:breakthrough-risk": "node tools/run.mjs breakthrough-risk-model",
    "balance:events": "node tools/run.mjs event-balance",
    "balance:visits": "node tools/run.mjs playstyles",
    "docs:tables": "node tools/dump-tables.mjs",
    "audit:save": "node tools/run.mjs economy-audit --save",
    "audit:review": "node tools/run.mjs balance-review",
    "bench:craft": "node tools/run.mjs craft-performance",
    "bench:offline": "node tools/run.mjs offline-benchmark"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "jsdom": "^30.1.2",
    "vite": "^8.3.3"
  }
}
